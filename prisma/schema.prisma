// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Source {
  id            String       @id @default(uuid())
  url           String      @unique
  contentHints  String?     @db.Text  // User-provided hints about content location
  structure     Json?       // AI-detected structure
  crawlSchedule String?     // cron expression
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  status        SourceStatus @default(ACTIVE)
  lastError     String?     @db.Text
  entries       Entry[]

  @@index([status])
}

model Entry {
  id          String   @id @default(uuid())
  title       String?
  content     String   @db.Text
  summary     String?  @db.Text
  metadata    Json
  source      Source   @relation(fields: [sourceId], references: [id])
  sourceId    String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  hash        String   // Content hash to detect changes

  @@unique([sourceId, hash])
  @@index([createdAt])
}

enum SourceStatus {
  ACTIVE
  PAUSED
  ERROR
  COMPLETED
}
